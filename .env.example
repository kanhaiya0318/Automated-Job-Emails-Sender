# Copy this file to .env and fill in your own values.
# Never commit .env, token.json or sent_emails.json.

# --- Apify (LinkedIn post scraper) ---
APIFY_API_TOKEN=your_apify_api_token

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_DECISION_MODEL=your_gemini_model_name

# --- Google OAuth (Gmail API, Desktop app client) ---
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# --- Your details (used in the email signature) ---
NAME="Your Full Name"
PHONE="+91-XXXXXXXXXX"
EMAIL=you@gmail.com
LINKEDIN=https://www.linkedin.com/in/your-handle

# --- Sending ---
TOKEN_FILE_PATH=data/credentials/token.json
RESUME_PATH=data/credentials/resume.pdf

# true = print emails only, false = actually send
DRY_RUN=true
SENT_FILE=sent_emails.json